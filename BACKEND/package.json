{
  "name": "atlas",
  "version": "1.0.0",
  "description": "API Atlas - Express + PostgreSQL (intencionalmente vulnerable)",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon",
    "test": "TZ=America/Santiago jest --runInBand --forceExit",
    "test:unit": "TZ=America/Santiago jest tests/unit",
    "test:integration": "TZ=America/Santiago jest tests/integration --runInBand --forceExit",
    "test:ci": "TZ=America/Santiago jest --runInBand --ci --forceExit --coverage --json --outputFile=reports/jest-results.json",
    "lint": "eslint src tests",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "pg": "^8.12.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "jest-html-reporters": "^3.1.7",
    "jest-junit": "^16.0.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.3.2"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ],
    "testTimeout": 60000,
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageDirectory": "reports/coverage",
    "coverageReporters": [
      "text-summary",
      "lcov",
      "json-summary",
      "html"
    ],
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "reports",
          "outputName": "junit.xml"
        }
      ],
      [
        "jest-html-reporters",
        {
          "publicPath": "reports/html",
          "filename": "index.html",
          "pageTitle": "Atlas - Resultados de pruebas",
          "expand": true
        }
      ]
    ]
  }
}
