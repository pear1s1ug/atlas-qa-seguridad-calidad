# Copie este archivo como .env o ejecute: ./scripts/generar-env.sh
COMPOSE_PROJECT_NAME=atlas
PORT_POSTGRES=15432
PORT_BACKEND=4450
PORT_FRONTEND=3350
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<cambiar>
POSTGRES_DB=atlas
# 32 bytes aleatorios en hexadecimal (openssl rand -hex 32)
JWT_SECRET=<cambiar>
DATA_ENCRYPTION_KEY=<cambiar>
